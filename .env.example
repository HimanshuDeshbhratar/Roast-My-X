# Free Gemini API key (required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional GitHub PAT for higher API rate limits
# GITHUB_TOKEN=

# Global cost caps (all users). Defaults: 200/hour, 1500/day
# GLOBAL_HOURLY_CAP=200
# GLOBAL_DAILY_CAP=1500

# GA4 measurement ID (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Screenshots: leave blank to use Microlink free tier
# SCREENSHOTONE_ACCESS_KEY=
# URLBOX_API_KEY=

# Optional webhook for email captures
# EMAIL_WEBHOOK_URL=

# Canonical site URL for Open Graph
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
